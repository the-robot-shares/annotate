# ── Project identity (derived by `make init`) ────────────────────
PROJECT_SLUG=annotate
REGISTRY=ops.noizu.com

# ── Postgres (container hostname on lets-go_default network) ─────
DATABASE_URL=ecto://annotate:starter_dev@db:5432/start_app_dev

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://annotate:starter_dev@redis:6379/0
REDIS_KEY_PREFIX=annotate:

# ── Secrets (generated by `make init`) ───────────────────────────
SECRET_KEY_BASE=CHANGE_ME
GUARDIAN_SECRET_KEY=CHANGE_ME
# Session cookie signing salt. REQUIRED in prod (boot fails without it); in
# dev/test a strong random salt is generated per boot when unset (sessions
# reset on restart — that is intentional; never commit a literal salt).
SESSION_SIGNING_SALT=

# ── App ──────────────────────────────────────────────────────────
PHX_HOST=localhost
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://app.localhost:8080
NEXT_PUBLIC_COOKIE_DOMAIN=
# Absolute URL of the frontend — SSO callbacks redirect here.
FRONTEND_URL=http://localhost:8080

# ── SSO: Authentik (OIDC) ───────────────────────────────────────
# The "Sign in with SSO" button + /auth/oidc flow activate when
# OIDC_CLIENT_ID is set. Authentik is the default OIDC provider.
# Register an OAuth2/OIDC provider + application in Authentik, then:
#   OIDC_ISSUER       = https://auth.derobot.is/application/o/<app-slug>
#   OIDC_REDIRECT_URI = https://<your-host>/auth/oidc/callback  (default: derived from PHX_HOST)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Deprecated legacy toggle; prefer SSO_AUTO_APPROVE_DOMAINS for approval policy.
SSO_REQUIRE_INVITE=false
# SSO availability by email domain. Format: "example.com=oidc;corp.example=google,oidc"
SSO_DOMAINS=
# SSO domains whose new registrations bypass manual approval. Format: "example.com;corp.example" or "*"
SSO_AUTO_APPROVE_DOMAINS=

# ── Port (nginx, host-side) ─────────────────────────────────────
PORT=8080
